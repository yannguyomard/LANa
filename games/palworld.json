{
  "id": "palworld",
  "name": "Palworld",
  "install": {
    "type": "steamcmd",
    "appid": 2394010,
    "platform": "windows",
    "check_file": "PalServer.exe"
  },
  "run": {
    "runtime": "wine",
    "command": [
      "PalServer.exe",
      "-port={port}",
      "-useperfthreads",
      "-NoAsyncLoadingThread",
      "-UseMultithreadForDS"
    ],
    "cwd": ".",
    "startup_seconds": 120
  },
  "requirements": {
    "ram_gb_min": 8,
    "ram_gb_recommended": 16,
    "disk_gb": 12,
    "note": "Serveur très gourmand : 8 Go est le minimum de Pocketpair, avec risque de plantage par manque de mémoire."
  },
  "ports": [
    {
      "from": "lana:port",
      "offset": 0,
      "proto": "udp",
      "label": "Jeu"
    }
  ],
  "connect": "{lan_ip}:{port}",
  "players": {
    "verified": false,
    "note": "Format de journal tiré d'un modèle tiers (AMP), pas encore vérifié sur un serveur LANa avec de vrais joueurs.",
    "join": "^(?:\\[(?P<date>[\\d-]+) (?P<time>[\\d:]+)\\] \\[LOG\\] )?(?P<name>.+) (?P<endpoint>\\S+) connected the server\\. \\(User id: (?P<id>[^)]+)\\)\\s*$",
    "leave": "^(?:\\[(?P<date>[\\d-]+) (?P<time>[\\d:]+)\\] \\[LOG\\] )?(?P<name>.+) left the server\\. \\(User id: (?P<id>[^)]+)\\)\\s*$",
    "sample": {
      "join": "[2026-11-01 12:00:00] [LOG] Zajabel 192.168.1.20 connected the server. (User id: steam_76561198000000000)",
      "leave": "[2026-11-01 12:30:00] [LOG] Zajabel left the server. (User id: steam_76561198000000000)"
    }
  },
  "savegame": "Pal/Saved/SaveGames",
  "config": {
    "file": "Pal/Saved/Config/WindowsServer/PalWorldSettings.ini",
    "format": "ue_options",
    "section": "/Script/Pal.PalGameWorldSettings",
    "seed_from": "DefaultPalWorldSettings.ini",
    "initial": {
      "ServerName": "Serveur Palworld",
      "ServerPlayerMaxNum": 4,
      "AdminPassword": "{random}"
    }
  },
  "fields": [
    {
      "key": "ServerName",
      "label": "Nom du serveur",
      "type": "text",
      "group": "Serveur",
      "default": "Default Palworld Server",
      "maxlen": 60
    },
    {
      "key": "ServerDescription",
      "label": "Description",
      "type": "text",
      "group": "Serveur",
      "default": "",
      "maxlen": 200,
      "required": false
    },
    {
      "key": "ServerPassword",
      "label": "Mot de passe (vide = ouvert)",
      "type": "text",
      "group": "Serveur",
      "default": "",
      "maxlen": 60,
      "required": false
    },
    {
      "key": "AdminPassword",
      "label": "Mot de passe administrateur",
      "type": "text",
      "group": "Serveur",
      "advanced": true,
      "default": "",
      "maxlen": 60,
      "required": false,
      "hint": "Donne accès aux commandes d'admin en jeu (/AdminPassword …)"
    },
    {
      "key": "ServerPlayerMaxNum",
      "label": "Joueurs maximum",
      "type": "int",
      "group": "Serveur",
      "default": 32,
      "min": 1,
      "max": 32
    },
    {
      "key": "lana:port",
      "label": "Port de jeu (UDP)",
      "type": "int",
      "group": "Serveur",
      "advanced": true,
      "default": 8211,
      "min": 1024,
      "max": 65535,
      "hint": "Port UDP à ouvrir sur la box"
    },
    {
      "key": "bShowPlayerList",
      "label": "Liste des joueurs visible",
      "type": "bool",
      "group": "Serveur",
      "advanced": true,
      "default": false
    },
    {
      "key": "bEnableVoiceChat",
      "label": "Chat vocal",
      "type": "bool",
      "group": "Serveur",
      "default": false
    },
    {
      "key": "RCONEnabled",
      "label": "RCON (administration à distance)",
      "type": "bool",
      "group": "Administration",
      "advanced": true,
      "default": false
    },
    {
      "key": "RCONPort",
      "label": "Port RCON",
      "type": "int",
      "group": "Administration",
      "advanced": true,
      "default": 25575,
      "min": 1024,
      "max": 65535
    },
    {
      "key": "RESTAPIEnabled",
      "label": "API REST",
      "type": "bool",
      "group": "Administration",
      "advanced": true,
      "default": false
    },
    {
      "key": "RESTAPIPort",
      "label": "Port de l'API REST",
      "type": "int",
      "group": "Administration",
      "advanced": true,
      "default": 8212,
      "min": 1024,
      "max": 65535
    },
    {
      "key": "DeathPenalty",
      "label": "Pénalité de mort",
      "type": "enum",
      "group": "Règles",
      "default": "Item",
      "options": [
        "None",
        "Item",
        "ItemAndEquipment",
        "All"
      ],
      "labels": {
        "None": "Rien",
        "Item": "Objets (sans l'équipement)",
        "ItemAndEquipment": "Objets et équipement",
        "All": "Tout, Pals compris"
      }
    },
    {
      "key": "bIsPvP",
      "label": "Mode PvP",
      "type": "bool",
      "group": "Règles",
      "default": false
    },
    {
      "key": "bEnablePlayerToPlayerDamage",
      "label": "Dégâts entre joueurs",
      "type": "bool",
      "group": "Règles",
      "advanced": true,
      "default": false
    },
    {
      "key": "bEnableFriendlyFire",
      "label": "Tirs alliés",
      "type": "bool",
      "group": "Règles",
      "advanced": true,
      "default": false
    },
    {
      "key": "bHardcore",
      "label": "Hardcore (pas de réapparition)",
      "type": "bool",
      "group": "Règles",
      "default": false
    },
    {
      "key": "bPalLost",
      "label": "Perte des Pals à la mort",
      "type": "bool",
      "group": "Règles",
      "default": false
    },
    {
      "key": "bEnableInvaderEnemy",
      "label": "Raids ennemis sur les bases",
      "type": "bool",
      "group": "Règles",
      "default": true
    },
    {
      "key": "bEnableFastTravel",
      "label": "Voyage rapide",
      "type": "bool",
      "group": "Règles",
      "default": true
    },
    {
      "key": "bIsStartLocationSelectByMap",
      "label": "Choisir son point de départ sur la carte",
      "type": "bool",
      "group": "Règles",
      "advanced": true,
      "default": false
    },
    {
      "key": "bExistPlayerAfterLogout",
      "label": "Le personnage reste dans le monde à la déconnexion",
      "type": "bool",
      "group": "Règles",
      "advanced": true,
      "default": false
    },
    {
      "key": "bBuildAreaLimit",
      "label": "Pas de construction près des points de voyage rapide",
      "type": "bool",
      "group": "Règles",
      "advanced": true,
      "default": false
    },
    {
      "key": "DayTimeSpeedRate",
      "label": "Vitesse du jour (×)",
      "type": "float",
      "group": "Monde",
      "advanced": true,
      "default": 1,
      "min": 0.1,
      "max": 5,
      "hint": "Bornes LANa : 0.1 à 5 · défaut 1"
    },
    {
