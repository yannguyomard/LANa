{
  "id": "l4d2",
  "name": "Left 4 Dead 2",
  "install": {
    "type": "steamcmd",
    "appid": 222860,
    "check_file": "left4dead2/gameinfo.txt",
    "make_dirs": [
      "left4dead2/cfg"
    ]
  },
  "run": {
    "runtime": "wine",
    "command": [
      "srcds.exe",
      "-console",
      "-game",
      "left4dead2",
      "-port",
      "{port}",
      "+maxplayers",
      "{max_players}",
      "+map",
      "{map}"
    ],
    "cwd": ".",
    "startup_seconds": 30,
    "linux": {
      "runtime": "native",
      "command": [
        "./srcds_run",
        "-console",
        "-game",
        "left4dead2",
        "-port",
        "{port}",
        "+maxplayers",
        "{max_players}",
        "+map",
        "{map}"
      ]
    }
  },
  "requirements": {
    "ram_gb_min": 1,
    "ram_gb_recommended": 2,
    "disk_gb": 12
  },
  "ports": [
    {
      "from": "lana:port",
      "offset": 0,
      "proto": "udp",
      "label": "Jeu"
    },
    {
      "from": "lana:port",
      "offset": 0,
      "proto": "tcp",
      "label": "RCON"
    }
  ],
  "connect": "{lan_ip}:{port}",
  "savegame": "left4dead2/cfg",
  "config": {
    "file": "left4dead2/cfg/server.cfg",
    "format": "cfg",
    "initial": {
      "hostname": "Un serveur LANa",
      "rcon_password": "{random}",
      "sv_password": ""
    }
  },
  "fields": [
    {
      "key": "hostname",
      "label": "Nom du serveur",
      "type": "text",
      "default": "Un serveur LANa",
      "group": "Serveur",
      "maxlen": 64
    },
    {
      "key": "sv_password",
      "label": "Mot de passe (vide = ouvert)",
      "type": "text",
      "default": "",
      "group": "Serveur",
      "required": false,
      "maxlen": 64
    },
    {
      "key": "rcon_password",
      "label": "Mot de passe RCON (administration à distance)",
      "type": "text",
      "default": "",
      "group": "Serveur",
      "advanced": true,
      "required": false,
      "maxlen": 64
    },
    {
      "key": "sv_lan",
      "label": "Réseau local uniquement",
      "type": "bool",
      "default": false,
      "group": "Serveur", "advanced": true
    },
    {
      "key": "lana:port",
      "label": "Port",
      "type": "int",
      "default": 27015,
      "group": "Réseau",
      "advanced": true,
      "min": 1024,
      "max": 65535,
      "hint": "Port à ouvrir sur la box"
    },
    {
      "key": "lana:max_players",
      "label": "Joueurs maximum",
      "type": "int",
      "default": 8,
      "group": "Serveur",
      "min": 2,
      "max": 64
    },
    {
      "key": "lana:map",
      "label": "Carte de départ",
      "type": "text",
      "default": "c1m1_hotel",
      "group": "Jeu",
      "maxlen": 64,
      "pattern": "^[A-Za-z0-9_\\-]+$"
    },
    {
      "key": "z_difficulty",
      "label": "Difficulté",
      "type": "enum",
      "default": "Normal",
      "group": "Jeu",
      "options": [
        "Easy",
        "Normal",
        "Hard",
        "Impossible"
      ],
      "labels": {
        "Easy": "Facile",
        "Normal": "Normale",
        "Hard": "Avancée",
        "Impossible": "Expert"
      }
    },
    {
      "key": "sv_allow_lobby_connect_only",
      "label": "Connexion par salon uniquement",
      "type": "bool",
      "default": false,
      "group": "Serveur", "advanced": true
    }
  ],
  "untested": true
}
