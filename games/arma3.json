{
  "id": "arma3",
  "name": "Arma 3",
  "install": {
    "type": "steamcmd",
    "appid": 233780,
    "check_file": "arma3server_x64.exe",
    "check_file_linux": "arma3server_x64",
    "login": "account",
    "make_dirs": [
      "profiles"
    ]
  },
  "run": {
    "runtime": "wine",
    "command": [
      "arma3server_x64.exe",
      "-port={port}",
      "-config=server.cfg",
      "-profiles=profiles",
      "-name=lana"
    ],
    "cwd": ".",
    "startup_seconds": 120,
    "linux": {
      "runtime": "native",
      "command": [
        "./arma3server_x64",
        "-port={port}",
        "-config=server.cfg",
        "-profiles=profiles",
        "-name=lana"
      ]
    }
  },
  "requirements": {
    "ram_gb_min": 4,
    "ram_gb_recommended": 8,
    "disk_gb": 10,
    "note": "Le serveur ne se télécharge qu'avec un compte Steam qui possède Arma 3."
  },
  "ports": [
    {
      "from": "lana:port",
      "offset": 0,
      "proto": "udp",
      "label": "Jeu"
    },
    {
      "from": "lana:port",
      "offset": 1,
      "proto": "udp",
      "label": "Requêtes Steam"
    },
    {
      "from": "lana:port",
      "offset": 2,
      "proto": "udp",
      "label": "Jeu (3)"
    },
    {
      "from": "lana:port",
      "offset": 4,
      "proto": "udp",
      "label": "BattlEye"
    }
  ],
  "connect": "{lan_ip}:{port}",
  "savegame": "profiles",
  "config": {
    "file": "server.cfg",
    "format": "arma",
    "initial": {
      "hostname": "Un serveur LANa",
      "passwordAdmin": "{random}",
      "maxPlayers": 32
    }
  },
  "fields": [
    {
      "key": "hostname",
      "label": "Nom du serveur",
      "type": "text",
      "default": "Un serveur LANa",
      "group": "Serveur",
      "maxlen": 60
    },
    {
      "key": "password",
      "label": "Mot de passe (vide = ouvert)",
      "type": "text",
      "default": "",
      "group": "Serveur",
      "required": false,
      "maxlen": 64
    },
    {
      "key": "passwordAdmin",
      "label": "Mot de passe administrateur",
      "type": "text",
      "default": "",
      "group": "Serveur",
      "required": false,
      "maxlen": 64
    },
    {
      "key": "maxPlayers",
      "label": "Joueurs maximum",
      "type": "int",
      "default": 32,
      "group": "Serveur",
      "min": 1,
      "max": 256
    },
    {
      "key": "persistent",
      "label": "Mission persistante (continue sans joueur)",
      "type": "bool",
      "default": false,
      "group": "Jeu"
    },
    {
      "key": "BattlEye",
      "label": "Anti-triche BattlEye",
      "type": "bool",
      "default": true,
      "group": "Serveur"
    },
    {
      "key": "disableVoN",
      "label": "Désactiver la voix en jeu",
      "type": "bool",
      "default": false,
      "group": "Jeu"
    },
    {
      "key": "verifySignatures",
      "label": "Vérification des mods (2 = stricte)",
      "type": "int",
      "default": 2,
      "group": "Serveur",
      "min": 0,
      "max": 2
    },
    {
      "key": "lana:port",
      "label": "Port",
      "type": "int",
      "default": 2302,
      "group": "Réseau",
      "min": 1024,
      "max": 65535,
      "hint": "Ouvrir aussi les ports suivants jusqu'à +4 (UDP)"
    }
  ],
  "untested": true
}
