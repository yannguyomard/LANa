{
  "id": "theisle",
  "name": "The Isle (Evrima)",
  "install": {
    "type": "steamcmd",
    "appid": 412680,
    "check_file": "TheIsle",
    "beta": "evrima"
  },
  "run": {
    "runtime": "wine",
    "command": [
      "TheIsleServer.exe",
      "-log",
      "-Port={port}"
    ],
    "cwd": ".",
    "startup_seconds": 180,
    "linux": {
      "runtime": "native",
      "command": [
        "./TheIsleServer.sh",
        "-log",
        "-Port={port}"
      ]
    }
  },
  "requirements": {
    "ram_gb_min": 6,
    "ram_gb_recommended": 8,
    "disk_gb": 15,
    "note": "Evrima exige des identifiants Epic Online Services (DedicatedServerClientId et DedicatedServerClientSecret) dans la section [EpicOnlineServices] de Engine.ini, à côté de Game.ini."
  },
  "ports": [
    {
      "from": "lana:port",
      "offset": 0,
      "proto": "udp",
      "label": "Jeu"
    },
    {
      "from": "lana:port",
      "offset": 0,
      "proto": "tcp",
      "label": "Jeu (TCP)"
    }
  ],
  "connect": "{lan_ip}:{port}",
  "savegame": "TheIsle/Saved/Databases",
  "config": {
    "file": "TheIsle/Saved/Config/WindowsServer/Game.ini",
    "file_linux": "TheIsle/Saved/Config/LinuxServer/Game.ini",
    "format": "ini",
    "initial": {
      "[/Script/TheIsle.TIGameSession]ServerName": "Un serveur LANa",
      "[/Script/TheIsle.TIGameSession]MaxPlayerCount": 50
    }
  },
  "fields": [
    {
      "key": "[/Script/TheIsle.TIGameSession]ServerName",
      "label": "Nom du serveur",
      "type": "text",
      "default": "Un serveur LANa",
      "group": "Serveur",
      "maxlen": 60
    },
    {
      "key": "[/Script/TheIsle.TIGameSession]MaxPlayerCount",
      "label": "Joueurs maximum",
      "type": "int",
      "default": 50,
      "group": "Serveur",
      "min": 1,
      "max": 200
    },
    {
      "key": "[/Script/TheIsle.TIGameSession]bServerPassword",
      "label": "Protéger par mot de passe",
      "type": "bool",
      "default": false,
      "group": "Serveur"
    },
    {
      "key": "[/Script/TheIsle.TIGameSession]ServerPassword",
      "label": "Mot de passe (vide = ouvert)",
      "type": "text",
      "default": "",
      "group": "Serveur",
      "required": false,
      "maxlen": 64
    },
    {
      "key": "[/Script/TheIsle.TIGameSession]bEnableHumans",
      "label": "Humains jouables",
      "type": "bool",
      "default": false,
      "group": "Jeu"
    },
    {
      "key": "[/Script/TheIsle.TIGameSession]bServerDynamicWeather",
      "label": "Météo dynamique",
      "type": "bool",
      "default": true,
      "group": "Jeu"
    },
    {
      "key": "lana:port",
      "label": "Port",
      "type": "int",
      "default": 7777,
      "group": "Réseau",
      "min": 1024,
      "max": 65535,
      "hint": "Port à ouvrir sur la box"
    }
  ],
  "untested": true
}
