{
  "id": "enshrouded",
  "name": "Enshrouded",
  "install": {
    "type": "steamcmd",
    "appid": 2278520,
    "platform": "windows",
    "check_file": "enshrouded_server.exe"
  },
  "run": {
    "runtime": "wine",
    "command": [
      "enshrouded_server.exe"
    ],
    "cwd": ".",
    "startup_seconds": 45
  },
  "requirements": {
    "ram_gb_min": 6,
    "ram_gb_recommended": 12,
    "disk_gb": 10,
    "note": "Testé sur un Mac Intel de 8 Go : fonctionne pour 2 à 4 joueurs, avec des ralentissements possibles."
  },
  "ports": [
    {
      "from": "queryPort",
      "offset": -1,
      "proto": "udp",
      "label": "Jeu"
    },
    {
      "from": "queryPort",
      "offset": 0,
      "proto": "udp",
      "label": "Requêtes"
    }
  ],
  "connect": "{lan_ip}:{queryPort}",
  "savegame": "savegame",
  "save_import": [
    {
      "label": "Monde Enshrouded (.ksd)",
      "extensions": [".ksd"],
      "magic": "SV2C",
      "target": "world0.ksd"
    }
  ],
  "log_file": null,
  "config": {
    "file": "enshrouded_server.json",
    "format": "json",
    "initial": {
      "name": "Serveur Enshrouded",
      "saveDirectory": "./savegame",
      "logDirectory": "./logs",
      "ip": "0.0.0.0",
      "queryPort": 15637,
      "slotCount": 4,
      "tags": [],
      "voiceChatMode": "Proximity",
      "enableVoiceChat": false,
      "enableTextChat": false,
      "gameSettingsPreset": "Default",
      "gameSettings": {
        "playerHealthFactor": 1,
        "playerManaFactor": 1,
        "playerStaminaFactor": 1,
        "playerBodyHeatFactor": 1,
        "playerDivingTimeFactor": 1,
        "shroudTimeFactor": 1,
        "tombstoneMode": "AddBackpackMaterials",
        "enableDurability": true,
        "enableStarvingDebuff": false,
        "foodBuffDurationFactor": 1,
        "fromHungerToStarving": 600000000000,
        "enableGliderTurbulences": true,
        "weatherFrequency": "Normal",
        "fishingDifficulty": "Normal",
        "dayTimeDuration": 1800000000000,
        "nightTimeDuration": 720000000000,
        "curseModifier": "Normal",
        "tamingStartleRepercussion": "LoseSomeProgress",
        "flameLevelFogRemoval": 11,
        "miningDamageFactor": 1,
        "plantGrowthSpeedFactor": 1,
        "resourceDropStackAmountFactor": 1,
        "factoryProductionSpeedFactor": 1,
        "perkUpgradeRecyclingFactor": 0.5,
        "perkCostFactor": 1,
        "experienceCombatFactor": 1,
        "experienceMiningFactor": 1,
        "experienceExplorationQuestsFactor": 1,
        "randomSpawnerAmount": "Normal",
        "aggroPoolAmount": "Normal",
        "enemyDamageFactor": 1,
        "enemyHealthFactor": 1,
        "enemyStaminaFactor": 1,
        "enemyPerceptionRangeFactor": 1,
        "threatBonus": 1,
        "pacifyAllEnemies": false,
        "bossDamageFactor": 1,
        "bossHealthFactor": 1
      },
      "userGroups": [
        {
          "name": "Admin",
          "password": "{random}",
          "canKickBan": true,
          "canAccessInventories": true,
          "canEditWorld": true,
          "canEditBase": true,
          "canExtendBase": true,
          "reservedSlots": 0
        },
        {
          "name": "Friend",
          "password": "{random}",
          "canKickBan": false,
          "canAccessInventories": true,
          "canEditWorld": true,
          "canEditBase": true,
          "canExtendBase": false,
          "reservedSlots": 0
        },
        {
          "name": "Guest",
          "password": "{random}",
          "canKickBan": false,
          "canAccessInventories": false,
          "canEditWorld": true,
          "canEditBase": false,
          "canExtendBase": false,
          "reservedSlots": 0
        },
        {
          "name": "Visitor",
          "password": "{random}",
          "canKickBan": false,
          "canAccessInventories": false,
          "canEditWorld": false,
          "canEditBase": false,
          "canExtendBase": false,
          "reservedSlots": 0
        }
      ],
      "bannedAccounts": []
    }
  },
  "fields": [
    {
      "key": "name",
      "label": "Nom du serveur",
      "type": "text",
      "group": "Serveur",
      "default": "Serveur Enshrouded",
      "maxlen": 60
    },
    {
      "key": "slotCount",
      "label": "Places (1 à 16)",
      "type": "int",
      "min": 1,
      "max": 16,
      "default": 4,
      "group": "Serveur"
    },
    {
      "key": "queryPort",
      "label": "Port",
      "type": "int",
      "min": 1024,
      "max": 65535,
      "default": 15637,
      "group": "Serveur",
      "hint": "Ports UDP à ouvrir : ce port et le précédent"
    },
    {
      "key": "gameSettingsPreset",
      "label": "Préréglage de difficulté",
      "type": "enum",
      "options": [
        "Default",
        "Relaxed",
        "Hard",
        "Survival",
        "Custom"
      ],
      "default": "Default",
      "group": "Serveur",
      "hint": "Les paramètres de jeu ne s'appliquent qu'avec « Custom »"
    },
    {
      "key": "voiceChatMode",
      "label": "Mode vocal",
      "type": "enum",
      "options": [
        "Proximity",
        "Global"
      ],
      "default": "Proximity",
      "group": "Serveur"
    },
    {
      "key": "enableVoiceChat",
      "label": "Chat vocal",
      "type": "bool",
      "default": false,
      "group": "Serveur"
    },
    {
      "key": "enableTextChat",
      "label": "Chat écrit",
      "type": "bool",
      "default": false,
      "group": "Serveur"
    },
    {
      "key": "tags",
      "label": "Étiquettes de recherche",
      "type": "tags",
      "options": [
        "LookingForPlayers",
        "English",
        "German",
        "French",
        "Italian",
        "Japanese",
        "Korean",
        "Polish",
        "Portuguese",
        "Russian",
        "Spanish",
        "Thai",
        "Turkish",
        "Ukrainian",
        "Chinese",
        "Taiwanese",
        "BaseBuilding",
        "Exploration",
        "Roleplay"
      ],
      "default": [],
      "group": "Serveur"
    },
    {
      "key": "gameSettings.playerHealthFactor",
      "label": "Vie max des joueurs (×)",
      "group": "Jeu — Joueurs",
      "default": 1,
      "type": "float",
      "min": 0.25,
      "max": 4,
      "hint": "Entre 0.25 et 4 · défaut 1"
    },
    {
      "key": "gameSettings.playerManaFactor",
      "label": "Mana max (×)",
      "group": "Jeu — Joueurs",
      "default": 1,
      "type": "float",
      "min": 0.25,
      "max": 4,
      "hint": "Entre 0.25 et 4 · défaut 1"
