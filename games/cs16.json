{
  "id": "cs16",
  "name": "Counter-Strike 1.6",
  "install": {
    "type": "steamcmd",
    "appid": 90,
    "check_file": "cstrike/liblist.gam",
    "mod": "cstrike",
    "make_dirs": [
      "cstrike/cfg"
    ]
  },
  "run": {
    "runtime": "wine",
    "command": [
      "hlds.exe",
      "-console",
      "-game",
      "cstrike",
      "-port",
      "{port}",
      "+maxplayers",
      "{max_players}",
      "+map",
      "{map}"
    ],
    "cwd": ".",
    "startup_seconds": 30,
    "linux": {
      "runtime": "native",
      "command": [
        "./hlds_run",
        "-console",
        "-game",
        "cstrike",
        "-port",
        "{port}",
        "+maxplayers",
        "{max_players}",
        "+map",
        "{map}"
      ]
    }
  },
  "requirements": {
    "ram_gb_min": 1,
    "ram_gb_recommended": 2,
    "disk_gb": 5
  },
  "ports": [
    {
      "from": "lana:port",
      "offset": 0,
      "proto": "udp",
      "label": "Jeu"
    },
    {
      "from": "lana:port",
      "offset": 0,
      "proto": "tcp",
      "label": "RCON"
    }
  ],
  "connect": "{lan_ip}:{port}",
  "savegame": "cstrike/cfg",
  "config": {
    "file": "cstrike/server.cfg",
    "format": "cfg",
    "initial": {
      "hostname": "Un serveur LANa",
      "rcon_password": "{random}",
      "sv_password": ""
    }
  },
  "fields": [
    {
      "key": "hostname",
      "label": "Nom du serveur",
      "type": "text",
      "default": "Un serveur LANa",
      "group": "Serveur",
      "maxlen": 64
    },
    {
      "key": "sv_password",
      "label": "Mot de passe (vide = ouvert)",
      "type": "text",
      "default": "",
      "group": "Serveur",
      "required": false,
      "maxlen": 64
    },
    {
      "key": "rcon_password",
      "label": "Mot de passe RCON (administration à distance)",
      "type": "text",
      "default": "",
      "group": "Serveur",
      "required": false,
      "maxlen": 64
    },
    {
      "key": "sv_lan",
      "label": "Réseau local uniquement",
      "type": "bool",
      "default": false,
      "group": "Serveur"
    },
    {
      "key": "lana:port",
      "label": "Port",
      "type": "int",
      "default": 27015,
      "group": "Réseau",
      "min": 1024,
      "max": 65535,
      "hint": "Port à ouvrir sur la box"
    },
    {
      "key": "lana:max_players",
      "label": "Joueurs maximum",
      "type": "int",
      "default": 16,
      "group": "Serveur",
      "min": 2,
      "max": 64
    },
    {
      "key": "lana:map",
      "label": "Carte de départ",
      "type": "text",
      "default": "de_dust2",
      "group": "Jeu",
      "maxlen": 64,
      "pattern": "^[A-Za-z0-9_\\-]+$"
    },
    {
      "key": "mp_timelimit",
      "label": "Durée d'une carte (min)",
      "type": "int",
      "default": 20,
      "group": "Jeu",
      "min": 0,
      "max": 180
    },
    {
      "key": "mp_friendlyfire",
      "label": "Tirs amis",
      "type": "bool",
      "default": false,
      "group": "Jeu"
    },
    {
      "key": "mp_autoteambalance",
      "label": "Équilibrage des équipes",
      "type": "bool",
      "default": true,
      "group": "Jeu"
    },
    {
      "key": "sv_gravity",
      "label": "Gravité",
      "type": "int",
      "default": 800,
      "group": "Jeu",
      "min": 100,
      "max": 2000
    }
  ],
  "untested": true
}
