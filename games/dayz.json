{
  "id": "dayz",
  "name": "DayZ",
  "install": {
    "type": "steamcmd",
    "appid": 223350,
    "check_file": "DayZServer_x64.exe",
    "check_file_linux": "DayZServer",
    "login": "account",
    "make_dirs": [
      "profiles"
    ]
  },
  "run": {
    "runtime": "wine",
    "command": [
      "DayZServer_x64.exe",
      "-config=serverDZ.cfg",
      "-port={port}",
      "-profiles=profiles",
      "-dologs",
      "-adminlog",
      "-freezecheck"
    ],
    "cwd": ".",
    "startup_seconds": 180,
    "linux": {
      "runtime": "native",
      "command": [
        "./DayZServer",
        "-config=serverDZ.cfg",
        "-port={port}",
        "-profiles=profiles",
        "-dologs",
        "-adminlog",
        "-freezecheck"
      ]
    }
  },
  "requirements": {
    "ram_gb_min": 6,
    "ram_gb_recommended": 8,
    "disk_gb": 25,
    "note": "Le serveur ne se télécharge qu'avec un compte Steam qui possède DayZ."
  },
  "ports": [
    {
      "from": "lana:port",
      "offset": 0,
      "proto": "udp",
      "label": "Jeu"
    },
    {
      "from": "steamQueryPort",
      "offset": 0,
      "proto": "udp",
      "label": "Requêtes Steam"
    }
  ],
  "connect": "{lan_ip}:{port}",
  "savegame": "mpmissions/dayzOffline.chernarusplus/storage_1",
  "config": {
    "file": "serverDZ.cfg",
    "format": "arma",
    "initial": {
      "hostname": "Un serveur LANa",
      "passwordAdmin": "{random}"
    }
  },
  "fields": [
    {
      "key": "hostname",
      "label": "Nom du serveur",
      "type": "text",
      "default": "Un serveur LANa",
      "group": "Serveur",
      "maxlen": 60
    },
    {
      "key": "password",
      "label": "Mot de passe (vide = ouvert)",
      "type": "text",
      "default": "",
      "group": "Serveur",
      "required": false,
      "maxlen": 64
    },
    {
      "key": "passwordAdmin",
      "label": "Mot de passe administrateur",
      "type": "text",
      "default": "",
      "group": "Serveur",
      "required": false,
      "maxlen": 64
    },
    {
      "key": "maxPlayers",
      "label": "Joueurs maximum",
      "type": "int",
      "default": 32,
      "group": "Serveur",
      "min": 1,
      "max": 127
    },
    {
      "key": "lana:port",
      "label": "Port",
      "type": "int",
      "default": 2302,
      "group": "Réseau",
      "min": 1024,
      "max": 65535,
      "hint": "Port à ouvrir sur la box"
    },
    {
      "key": "steamQueryPort",
      "label": "Port de requêtes Steam",
      "type": "int",
      "default": 27016,
      "group": "Réseau",
      "min": 1024,
      "max": 65535,
      "hint": "Port à ouvrir sur la box"
    },
    {
      "key": "disable3rdPerson",
      "label": "Interdire la vue à la troisième personne",
      "type": "bool",
      "default": false,
      "group": "Jeu"
    },
    {
      "key": "disableCrosshair",
      "label": "Masquer le réticule",
      "type": "bool",
      "default": false,
      "group": "Jeu"
    },
    {
      "key": "serverTimeAcceleration",
      "label": "Accélération du temps",
      "type": "int",
      "default": 1,
      "group": "Serveur",
      "min": 0,
      "max": 24
    },
    {
      "key": "serverNightTimeAcceleration",
      "label": "Accélération de la nuit",
      "type": "int",
      "default": 1,
      "group": "Serveur",
      "min": 1,
      "max": 64
    },
    {
      "key": "verifySignatures",
      "label": "Vérification des mods (2 = stricte)",
      "type": "int",
      "default": 2,
      "group": "Serveur",
      "min": 0,
      "max": 2
    }
  ],
  "untested": true
}
