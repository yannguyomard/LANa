#!/bin/sh
# Point d'entrée de LANa.AppImage : lance l'appli de bureau (desktop/) avec le Python embarqué.
HERE="${APPDIR:-$(dirname "$(readlink -f "$0")")}"
export PYTHONHOME="$HERE/usr/python"
export PYTHONPATH="$HERE/usr/site-packages:$HERE/usr/lana"
export PYTHONDONTWRITEBYTECODE=1   # l'image est en lecture seule
export PYTHONNOUSERSITE=1
unset PYTHONSTARTUP

# Qt 6 sous X11 a besoin de libxcb-cursor : sans elle, l'appli s'arrête avec un message obscur.
if [ -z "${WAYLAND_DISPLAY:-}" ] && [ -n "${DISPLAY:-}" ]; then
    ldconfig_bin=$(command -v ldconfig 2>/dev/null || echo /sbin/ldconfig)
    if [ -x "$ldconfig_bin" ] && ! "$ldconfig_bin" -p 2>/dev/null | grep -q 'libxcb-cursor\.so\.0'; then
        echo "LANa : la bibliothèque libxcb-cursor manque. Installez-la, puis relancez :" >&2
        echo "  Debian, Ubuntu : sudo apt install libxcb-cursor0" >&2
        echo "  Fedora         : sudo dnf install xcb-util-cursor" >&2
        echo "  Arch           : sudo pacman -S xcb-util-cursor" >&2
    fi
fi

cd "$HERE/usr/lana" || exit 1
exec "$HERE/usr/python/bin/python3" -m desktop "$@"
